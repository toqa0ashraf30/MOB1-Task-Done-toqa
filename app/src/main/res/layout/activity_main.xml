<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/imagetask"
        android:layout_width="261dp"
        android:layout_height="382dp"
        android:layout_marginStart="75dp"
        android:layout_marginTop="112dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/whatsapp_image_2026_10_21_at_5_40_11_pm" />

    <TextView
        android:id="@+id/text_task"

        android:style="@style/texttask"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="451dp"
        android:text="All tasks completed"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/textnice"
        app:layout_constraintStart_toStartOf="@+id/imagetask"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textnice"
        android:style="@style/texttask"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="26dp"
        android:layout_marginEnd="26dp"
        android:layout_marginBottom="210dp"
        android:text="Nice Work!"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/text_task"
        app:layout_constraintStart_toStartOf="@+id/text_task"
        app:layout_constraintTop_toBottomOf="@+id/text_task" />
</androidx.constraintlayout.widget.ConstraintLayout>